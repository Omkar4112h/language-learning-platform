# Application Settings
APP_NAME=Language Learning Platform
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/language_learning

# JWT Settings
SECRET_KEY=your-super-secret-key-change-in-production-2024-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: ChatGPT-like AI Help (OpenAI-compatible)
# If OPENAI_API_KEY is set, AI Help (scenario='help') will use the model for open-ended answers.
# OPENAI_MODEL defaults to gpt-4o-mini if not provided.
# OPENAI_BASE_URL defaults to https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=

# CORS Origins (Frontend URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
